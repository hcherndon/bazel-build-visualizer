)

java_junit5_test(
    name = "GraphExtractTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [":test-lib"] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.analysis.GraphExtractTest",
