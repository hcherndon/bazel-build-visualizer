    name = "tests",
    tests = [
        ":ConcurrencySweepTest",
        ":CriticalPathTest",
        ":FindingRulesTest",
        ":FindingTest",
        ":GraphClusteringTest",
        ":GraphExtractTest",
        ":GraphLayoutTest",
        ":GraphWeightsTest",
        ":MetricFormulaScaleTest",
