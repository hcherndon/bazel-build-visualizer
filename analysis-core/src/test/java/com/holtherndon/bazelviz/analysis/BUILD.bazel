load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "TEST_JVM_FLAGS")

java_library(
    name = "test-lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//analysis-core/src/main/java/com/holtherndon/bazelviz/analysis",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/measure",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/source",
        "//graph-core/src/main/java/com/holtherndon/bazelviz/graph",
    ],
)

java_junit5_test(
    name = "ConcurrencySweepTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [":test-lib"] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.analysis.ConcurrencySweepTest",
)

java_junit5_test(
    name = "CriticalPathTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [":test-lib"] + JUNIT_RUNTIME_DEPS,
