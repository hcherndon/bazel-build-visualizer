load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin")
load("//tools:java_test_settings.bzl", "NATIVE_ACCESS_FLAG")

java_plugin(
    name = "jmh_processor",
    processor_class = "org.openjdk.jmh.generators.BenchmarkProcessor",
    deps = ["@maven//:org_openjdk_jmh_jmh_generator_annprocess"],
)

java_library(
    name = "jmh_benchmarks",
    srcs = [
        "SqliteInsertBench.java",
        "SyntheticGeneratorBench.java",
    ],
    plugins = [":jmh_processor"],
    deps = [
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage:storage",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/synthetic:synthetic",
        "@maven//:org_openjdk_jmh_jmh_core",
    ],
    visibility = ["//visibility:public"],
)

java_binary(
    name = "jmh",
    jvm_flags = [NATIVE_ACCESS_FLAG],
    main_class = "org.openjdk.jmh.Main",
    runtime_deps = [":jmh_benchmarks"],
    visibility = ["//visibility:public"],
)
