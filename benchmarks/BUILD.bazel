"""Stable aliases for package-local spike and JMH targets."""

load("@rules_java//java:defs.bzl", "java_library")

java_library(
    name = "benchmarks",
    exports = ["//benchmarks/src/main/java/com/holtherndon/bazelviz/benchmarks/spike:spike"],
    visibility = ["//visibility:public"],
)

alias(
    name = "table_spike",
    actual = "//benchmarks/src/main/java/com/holtherndon/bazelviz/benchmarks/spike:table_spike",
)

alias(
    name = "timeline_spike",
    actual = "//benchmarks/src/main/java/com/holtherndon/bazelviz/benchmarks/spike:timeline_spike",
)

alias(
    name = "graph_spike",
    actual = "//benchmarks/src/main/java/com/holtherndon/bazelviz/benchmarks/spike:graph_spike",
)

alias(
    name = "sql_paging_spike",
    actual = "//benchmarks/src/main/java/com/holtherndon/bazelviz/benchmarks/spike:sql_paging_spike",
)

alias(
    name = "bes_throughput_spike",
    actual = "//benchmarks/src/main/java/com/holtherndon/bazelviz/benchmarks/spike:bes_throughput_spike",
)

alias(
    name = "entity_scale_spike",
    actual = "//benchmarks/src/main/java/com/holtherndon/bazelviz/benchmarks/spike:entity_scale_spike",
)

alias(
    name = "jmh",
    actual = "//benchmarks/src/jmh/java/com/holtherndon/bazelviz/benchmarks/jmh:jmh",
)
