# Bazel Build Visualizer. ADR-009; scope and mechanics in
# docs/bazel-migration-plan.md.
module(name = "bbv")

bazel_dep(name = "rules_java", version = "9.8.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "protobuf", version = "36.0")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "platforms", version = "1.1.0")
# sh_binary left native Bazel in 9; the jpackage/notarize run targets need it.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Central dependency versions, transplanted from gradle/libs.versions.toml.
# Every third-party addition needs the review described in the agent execution
# contract (docs/adr, license, maintenance, performance justification) and
# must keep the lockfile green: adding a dependency is an edit here plus an
# explicit `REPIN=1 bazel run @maven//:pin`.
#
# Query-card editor stack (user-approved 2026-08-24, ui-swing only):
# - com.fifesoft:rsyntaxtextarea — BSD-3-Clause. SQL syntax highlighting for
#   the Query card's editor. Maintained by bobbylight (fifesoft) since 2003,
#   releases through 2025; the de facto standard Swing code editor (used by
#   jd-gui, DBeaver's predecessors, many others). Pure Swing, no native code,
#   no transitive dependencies; token-based incremental highlighting keeps
#   keystroke latency flat on multi-hundred-line SQL. Pinned to 3.6.1 — the
#   exact version autocomplete 3.3.3 declares — rather than the 4.x line,
#   because the author ships the pair together and 4.0 is a fresh major.
# - com.fifesoft:autocomplete — BSD-3-Clause, same author/cadence as
#   rsyntaxtextarea and released in lockstep with it. Schema-aware completion
#   (tables, columns, saved views) in the same editor; completions come from
#   an in-memory provider this codebase fills from SchemaTable, so no I/O on
#   the EDT is possible through it.
# - com.github.vertical-blank:sql-formatter — MIT. The Format button. Java
#   port of the sql-formatter JS library; zero dependencies, pure string
#   transform (no parsing of the session, no I/O), a few KB. Low release
#   cadence (2.0.5, 2024) is acceptable for a formatter whose input language
#   is stable; worst failure mode is ugly formatting of text the read-only
#   filter still checks afterwards.
#
# Remote-terminal stack (user-approved 2026-08-28):
# - org.jetbrains.jediterm:jediterm-core / jediterm-ui 3.74 — Apache-2.0
#   selected from the project's dual Apache-2.0/LGPL-3.0 grant. The official
#   source jars byte-match the current GitHub source tree even though the
#   generated POM names only LGPL-3.0. JetBrains publishes these exact jars to
#   its public IntelliJ-dependencies repository; 3.74 was built 2026-07-31
#   from an actively maintained project used by JetBrains IDEs. The two jars
#   provide bounded xterm parsing and the Swing terminal widget without an SSH
#   implementation; BBV keeps system OpenSSH as its transport.
# - org.jetbrains.pty4j:pty4j 0.13.8 — EPL-1.0. Creates a local PTY around the
#   system OpenSSH client so its remote PTY receives keyboard input and window
#   size changes. 0.13.8 is the version JediTerm 3.74's standalone application
#   pins, preferred over a newer unrelated release for tested compatibility.
#   The jar includes signed universal macOS binaries and native resources for
#   other supported hosts. It adds JNA 5.14.0; JNA is dual Apache-2.0/LGPL-2.1
#   and this application selects Apache-2.0. Kotlin stdlib and JetBrains
#   annotations are Apache-2.0; the existing SLF4J 2.0.18 pin wins over both
#   additions' lower requests. All remain inside the existing deploy jar.
#
# Repository-browser SVG stack (user-approved 2026-09-01, repository UI only):
# - com.formdev:flatlaf-extras 3.7.2 — Apache-2.0. This is the SVG add-on from
#   the same active FlatLaf release already used by the application. It keeps
#   the bundled file icons sharp on HiDPI displays and reuses one parsed icon
#   per type instead of rasterizing per tree row. The jar is 120 KiB.
# - com.github.weisj:jsvg 2.1.0 — MIT. FlatLaf Extras' pure-Java SVG renderer;
#   the release was current in May 2026, has no required transitives, and adds
#   784 KiB. It parses only the application's fixed, reviewed SVG resources,
#   never repository file contents or names as resource paths.
# - The 14,407-byte, 32-icon third-party subset is vendored verbatim from
#   Material Icon Theme 5.38.1 (MIT), commit
#   448ab3977ef83b817c2c722ce7cd5034d195b39f. BUILD/Starlark files and Bazel
#   directory links use two separate project-owned SVGs totalling 9,080 bytes.
#   All 34 icons total 23,487 bytes. Exact third-party licenses and provenance
#   ship in the collision-safe notice bundle.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # Pure-Java zstd for the compact execution log (enrichment).
        "io.airlift:aircompressor:2.0.3",
        "org.assertj:assertj-core:3.27.3",
        "com.fifesoft:autocomplete:3.3.3",
        "com.formdev:flatlaf:3.7.2",
        "com.formdev:flatlaf-extras:3.7.2",
        # Streaming JSON for the trace profile (enrichment). Declared rather
        # than inherited through protobuf-java-util, so the version is chosen.
        "com.google.code.gson:gson:2.14.0",
        "io.grpc:grpc-api:1.83.1",
        "io.grpc:grpc-netty-shaded:1.83.1",
        "io.grpc:grpc-protobuf:1.83.1",
        "io.grpc:grpc-stub:1.83.1",
        "org.junit.jupiter:junit-jupiter:6.1.3",
        "org.junit.platform:junit-platform-launcher:6.1.3",
        # The JUnit Platform test runner's XML writer; not in the Gradle
        # catalog because the Gradle test task carried its own.
        "org.junit.platform:junit-platform-reporting:6.1.3",
        "org.jetbrains.jediterm:jediterm-core:3.74",
        "org.jetbrains.jediterm:jediterm-ui:3.74",
        "org.jetbrains.pty4j:pty4j:0.13.8",
        "ch.qos.logback:logback-classic:1.6.3",
        "com.google.protobuf:protobuf-java:4.36.0",
        "com.google.protobuf:protobuf-java-util:4.36.0",
        "com.fifesoft:rsyntaxtextarea:3.6.1",
        "org.slf4j:slf4j-api:2.0.18",
        "com.github.vertical-blank:sql-formatter:2.0.5",
        "org.xerial:sqlite-jdbc:3.53.2.1",
        # JMH, previously supplied by the me.champeau.jmh Gradle plugin.
        "org.openjdk.jmh:jmh-core:1.37",
        "org.openjdk.jmh:jmh-generator-annprocess:1.37",
    ],
    fail_if_repin_required = True,
    # The protobuf BCR module layers its own runtime artifacts into this same
    # hub; acknowledged explicitly so the warning cannot hide a new module
    # quietly joining the hub later.
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://packages.jetbrains.team/maven/p/ij/intellij-dependencies",
    ],
)
use_repo(maven, "maven")

# ---------------------------------------------------------------- codegen
#
# The exact binaries the Gradle protobuf plugin resolved (ADR-009 §4.1): the
# BCR grpc-java module is deliberately NOT used — it trails the locked gRPC
# version and substitutes source builds for the audited maven jars. Parity
# with Gradle's generated sources is byte-diffed, not asserted. Two platforms
# only (dev macs and CI's ubuntu runners); add pins here the day another
# platform appears.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Build-time Java formatter (ADR-013): Apache-2.0, maintained by Google and
# current as of 2026-07-30. The standalone jar runs only over repository Java
# sources during builds or an explicit `bazel run //tools:format_java`; it is
# not linked into the application. A sha256 pin keeps the tool reproducible.
http_file(
    name = "google_java_format",
    downloaded_file_path = "google-java-format.jar",
    sha256 = "25b400f003089d23cc5320cdaf1a16cabee19b8aa3434d0ff021b3d9f42154b4",
    url = "https://github.com/google/google-java-format/releases/download/v1.36.1/google-java-format-1.36.1-all-deps.jar",
)

http_file(
    name = "protoc_bin_osx_aarch64",
    executable = True,
    sha256 = "ec83dc7cf850d3514b4779390f7572d9a72408d779490d59388746f375eb702e",
    url = "https://repo1.maven.org/maven2/com/google/protobuf/protoc/4.36.0/protoc-4.36.0-osx-aarch_64.exe",
)

http_file(
    name = "protoc_bin_linux_x86_64",
    executable = True,
    sha256 = "76bff0ac74c698072b5428dac8115afe2e8b9b7d5f23261f0bb4388fb47a1b2e",
    url = "https://repo1.maven.org/maven2/com/google/protobuf/protoc/4.36.0/protoc-4.36.0-linux-x86_64.exe",
)

http_file(
    name = "protoc_gen_grpc_java_osx_aarch64",
    executable = True,
    sha256 = "372e13b25cb058ea6e3ab6cb54ba1458d5d2bbe1cfdcd37bc57e82b872656e21",
    url = "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/1.83.1/protoc-gen-grpc-java-1.83.1-osx-aarch_64.exe",
)

http_file(
    name = "protoc_gen_grpc_java_linux_x86_64",
    executable = True,
    sha256 = "db4044e78391d5a23439143c8147f07ba5877675587b4d48f3b68fbee3893589",
    url = "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/1.83.1/protoc-gen-grpc-java-1.83.1-linux-x86_64.exe",
)
