load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "TEST_JVM_FLAGS")

java_library(
    name = "tests_lib",
    srcs = [
        "BepImporterBoundedMemoryTest.java",
        "BepImporterDamagedSourceTest.java",
        "BepImporterDeterminismTest.java",
        "BepImporterImportTest.java",
        "BepImporterJsonSourceTest.java",
        "BepImporterResumeTest.java",
        "BoundedMemoryImportMain.java",
        "ImportProgressTest.java",
        "ImportTestSupport.java",
        "JournalPayloadReaderTest.java",
        "NormalizationAnomalyTest.java",
        "NormalizationIdempotenceTest.java",
        "SourceCheckpointTest.java",
    ],
    deps = JUNIT_DEPS + [
        "//bep-codec/src/main/java/com/holtherndon/bazelviz/bepcodec:bepcodec",
        "//capture-file/src/main/java/com/holtherndon/bazelviz/capture/file/detect:detect",
        "//capture-file/src/main/java/com/holtherndon/bazelviz/capture/file/importer:importer",
        "//capture-file/src/main/java/com/holtherndon/bazelviz/capture/file/json:json",
        "//capture-file/src/main/java/com/holtherndon/bazelviz/capture/normalize:normalize",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/event:event",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/id:id",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/journal:journal",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/session:session",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/source:source",
        "//proto:proto",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/journal:journal",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session:session",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/events:events",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage:storage",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bep:bep",
    ],
    testonly = True,
    visibility = ["//visibility:public"],
)

