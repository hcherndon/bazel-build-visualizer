# Shared Java/test policy values and repository quality entry points. Package
# BUILD files invoke native and contrib_rules_jvm rules directly; this package
# does not define rule macros.

alias(
    name = "format_java",
    actual = "//tools/java_quality:format_java",
)

exports_files([
    "java_format.bzl",
    "java_test_settings.bzl",
])
