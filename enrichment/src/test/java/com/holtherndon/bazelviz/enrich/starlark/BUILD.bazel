load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "TEST_JVM_FLAGS")

java_library(
    name = "tests_lib",
    srcs = [
        "StarlarkCpuProfileImporterTest.java",
        "StarlarkCpuProfileParserTest.java",
        "StarlarkProfileFixture.java",
    ],
    deps = JUNIT_DEPS + [
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/enrich:enrich",
        "//enrichment/src/main/java/com/holtherndon/bazelviz/enrich/starlark:starlark",
        "//proto:proto",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/enrich:enrich",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/schema:schema",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage:storage",
        "@maven//:com_google_protobuf_protobuf_java",
    ],
    testonly = True,
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "StarlarkCpuProfileImporterTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [
        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.enrich.starlark.StarlarkCpuProfileImporterTest",
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "StarlarkCpuProfileParserTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [
        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.enrich.starlark.StarlarkCpuProfileParserTest",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        ":StarlarkCpuProfileImporterTest",
        ":StarlarkCpuProfileParserTest",
    ],
    visibility = ["//visibility:public"],
)
