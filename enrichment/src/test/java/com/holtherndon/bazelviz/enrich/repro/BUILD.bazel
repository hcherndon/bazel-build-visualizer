load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "TEST_JVM_FLAGS")

java_library(
    name = "tests_lib",
    srcs = ["ExecutionLogComparisonTest.java"],
    deps = JUNIT_DEPS + [
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/filter:filter",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/repro:repro",
        "//enrichment/src/main/java/com/holtherndon/bazelviz/enrich/repro:repro",
        "//proto:proto",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:io_airlift_aircompressor",
    ],
    testonly = True,
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "ExecutionLogComparisonTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [":tests_lib"] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.enrich.repro.ExecutionLogComparisonTest",
    visibility = ["//visibility:public"],
)
