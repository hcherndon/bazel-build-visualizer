load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "TEST_JVM_FLAGS")

java_library(
    name = "tests_lib",
    srcs = ["SubprocessTest.java"],
    testonly = True,
    deps = JUNIT_DEPS + ["//runner/src/main/java/com/holtherndon/bazelviz/runner/proc:proc"],
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "SubprocessTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [":tests_lib"] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.runner.proc.SubprocessTest",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [":SubprocessTest"],
    visibility = ["//visibility:public"],
)
