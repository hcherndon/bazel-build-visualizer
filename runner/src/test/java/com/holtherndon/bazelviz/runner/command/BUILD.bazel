load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "TEST_JVM_FLAGS")

java_library(
    name = "test-lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/caps",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/command",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/proc",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/runtime",
    ],
)

java_junit5_test(
    name = "EffectiveOptionsExecutorTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [":test-lib"] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.runner.command.EffectiveOptionsExecutorTest",
)

java_junit5_test(
    name = "CommandLineParserTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [":test-lib"] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.runner.command.CommandLineParserTest",
)

test_suite(
    name = "tests",
    tests = [
        ":CommandLineParserTest",
        ":EffectiveOptionsExecutorTest",
    ],
    visibility = ["//visibility:public"],
)
