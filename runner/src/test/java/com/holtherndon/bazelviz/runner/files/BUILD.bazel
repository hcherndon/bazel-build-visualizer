load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "TEST_JVM_FLAGS")

java_library(
    name = "test-lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/files",
    ],
)

java_junit5_test(
    name = "LocalExecutionFileSystemTest",
    test_class = "com.holtherndon.bazelviz.runner.files.LocalExecutionFileSystemTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":test-lib"],
)

test_suite(
    name = "tests",
    tests = [":LocalExecutionFileSystemTest"],
    visibility = ["//visibility:public"],
)
