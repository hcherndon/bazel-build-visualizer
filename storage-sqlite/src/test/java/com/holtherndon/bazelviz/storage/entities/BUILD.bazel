        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.storage.entities.ConfigurationQueriesTest",
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "EntityWriterTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [
        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.storage.entities.EntityWriterTest",
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "ErrorQueriesTest",
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [
        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.storage.entities.ErrorQueriesTest",
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "TargetQueriesTest",
