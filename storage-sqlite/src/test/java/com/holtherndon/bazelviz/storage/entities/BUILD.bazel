    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = [
        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.storage.entities.TestQueriesTest",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        ":ActionQueriesTest",
        ":ConfigurationQueriesTest",
        ":EntityWriterTest",
        ":ErrorQueriesTest",
        ":TargetQueriesTest",
        ":TestQueriesTest",
    ],
    visibility = ["//visibility:public"],
