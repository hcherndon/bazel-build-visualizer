"""Compatibility facade for the package-local live-capture targets."""

load("@rules_java//java:defs.bzl", "java_library")

java_library(
    name = "capture-bes",
    exports = [
        "//capture-bes/src/main/java/com/holtherndon/bazelviz/capture/bes:bes",
        "//capture-bes/src/main/java/com/holtherndon/bazelviz/capture/live:live",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        "//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/bes:tests",
        "//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/live:tests",
    ],
)

# THE SUPPORTED-VERSION COMPATIBILITY CHECK. Refreshing the full matrix starts
# several Bazel servers and has previously exhausted the development machine's
# memory. Both this stable wrapper and the package-local test are manual and
# carry the bazel-sweep tag. Run one version at a time, deliberately:
#
#   BBV_BAZEL_MATRIX_VERSION=<supported> bazel test //capture-bes:BazelVersionMatrixTest --test_tag_filters=bazel-sweep --test_output=streamed
test_suite(
    name = "BazelVersionMatrixTest",
    tags = [
        "bazel-sweep",
        "manual",
    ],
    tests = ["//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/live:BazelVersionMatrixTest"],
)

alias(
    name = "RealBazelBesTest",
    actual = "//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/bes:RealBazelBesTest",
)

alias(
    name = "RealBazelCaptureTest",
    actual = "//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/live:RealBazelCaptureTest",
)

alias(
    name = "RealBazelEnrichmentTest",
    actual = "//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/live:RealBazelEnrichmentTest",
)

alias(
    name = "RealBazelGraphTest",
    actual = "//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/live:RealBazelGraphTest",
)

alias(
    name = "RealBazelNormalizationTest",
    actual = "//capture-bes/src/test/java/com/holtherndon/bazelviz/capture/live:RealBazelNormalizationTest",
)
