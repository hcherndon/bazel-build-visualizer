    name = "RealBazelBesTest",
    srcs = ["RealBazelBesTest.java"],
    deps = JUNIT_DEPS + [
        "//bep-codec/src/main/java/com/holtherndon/bazelviz/bepcodec:bepcodec",
        "//capture-bes/src/main/java/com/holtherndon/bazelviz/capture/bes:bes",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/journal:journal",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bazel:bazel",
        ":tests_lib",
    ],
    env_inherit = REAL_BAZEL_ENV,
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS,
