java_junit5_test(
    name = "RealBazelNormalizationTest",
    srcs = ["RealBazelNormalizationTest.java"],
    deps = JUNIT_DEPS + [
        "//capture-bes/src/main/java/com/holtherndon/bazelviz/capture/live:live",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/caps:caps",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/plan:plan",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session:session",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage:storage",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bazel:bazel",
        ":tests_lib",
    ],
    env_inherit = REAL_BAZEL_ENV,
    jvm_flags = TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS,
    size = "large",
    # Its live-reader case deliberately races SQLite initialization against
    # the capture writer. Competing child-Bazel tests caused a reproducible
    # SQLITE_BUSY failure; keep this one isolated while retaining parallelism
    # for the other real-Bazel targets.
    tags = REAL_BAZEL_TAGS + ["exclusive"],
    test_class = "com.holtherndon.bazelviz.capture.live.RealBazelNormalizationTest",
    visibility = ["//visibility:public"],
)

