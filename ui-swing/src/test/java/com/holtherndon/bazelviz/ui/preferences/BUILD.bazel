load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS")

package(default_visibility = ["//ui-swing:__pkg__"])

java_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/preferences",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/theme",
        "@maven//:com_fifesoft_rsyntaxtextarea",
    ],
    visibility = ["//visibility:private"],
)

java_junit5_test(
    name = "PreferencesPanelTest",
    test_class = "com.holtherndon.bazelviz.ui.preferences.PreferencesPanelTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "ThemePreferencesPanelTest",
    test_class = "com.holtherndon.bazelviz.ui.preferences.ThemePreferencesPanelTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "WorkspaceDiscoveryPreferencesPanelTest",
    test_class = "com.holtherndon.bazelviz.ui.preferences.WorkspaceDiscoveryPreferencesPanelTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

test_suite(
    name = "tests",
    tests = [
        ":PreferencesPanelTest",
        ":ThemePreferencesPanelTest",
        ":WorkspaceDiscoveryPreferencesPanelTest",
    ],
)
