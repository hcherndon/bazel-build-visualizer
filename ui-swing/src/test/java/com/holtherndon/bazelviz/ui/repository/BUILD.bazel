load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS")

package(default_visibility = ["//ui-swing:__pkg__"])

java_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/files",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/repository",
    ],
    visibility = ["//visibility:private"],
)

java_junit5_test(
    name = "RepositoryBrowserViewTest",
    test_class = "com.holtherndon.bazelviz.ui.repository.RepositoryBrowserViewTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "RepositoryFileIconsTest",
    test_class = "com.holtherndon.bazelviz.ui.repository.RepositoryFileIconsTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

test_suite(
    name = "tests",
    tests = [
        ":RepositoryBrowserViewTest",
        ":RepositoryFileIconsTest",
    ],
)
