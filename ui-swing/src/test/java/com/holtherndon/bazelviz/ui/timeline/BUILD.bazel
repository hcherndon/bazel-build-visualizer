load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS")

package(default_visibility = ["//ui-swing:__pkg__"])

java_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/domain",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/session",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/entities",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/graph",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/metrics",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/inspect",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/nav",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/session",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/theme",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/timeline",
    ],
    visibility = ["//visibility:private"],
)

java_junit5_test(
    name = "LaneGroupingTest",
    test_class = "com.holtherndon.bazelviz.ui.timeline.LaneGroupingTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "MacMagnificationSupportTest",
    test_class = "com.holtherndon.bazelviz.ui.timeline.MacMagnificationSupportTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS + select({
        "@platforms//os:macos": [
            "--add-exports=java.desktop/com.apple.eawt.event=ALL-UNNAMED",
        ],
        "//conditions:default": [],
    }),
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

