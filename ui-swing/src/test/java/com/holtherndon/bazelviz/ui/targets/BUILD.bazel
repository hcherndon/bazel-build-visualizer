load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS")

package(default_visibility = ["//ui-swing:__pkg__"])

java_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//capture-file/src/main/java/com/holtherndon/bazelviz/capture/file/importer",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/domain",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/entities",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bep",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/inspect",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/nav",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/session",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/targets",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/theme",
    ],
    visibility = ["//visibility:private"],
)

java_junit5_test(
    name = "AllTargetsViewTest",
    test_class = "com.holtherndon.bazelviz.ui.targets.AllTargetsViewTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "TargetInspectionTest",
    test_class = "com.holtherndon.bazelviz.ui.targets.TargetInspectionTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "TargetsViewRevealTest",
    test_class = "com.holtherndon.bazelviz.ui.targets.TargetsViewRevealTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "TargetsViewWiringTest",
    test_class = "com.holtherndon.bazelviz.ui.targets.TargetsViewWiringTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "TargetsPageChromeTest",
    test_class = "com.holtherndon.bazelviz.ui.targets.TargetsPageChromeTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

test_suite(
    name = "tests",
    tests = [
        ":AllTargetsViewTest",
        ":TargetInspectionTest",
        ":TargetsViewRevealTest",
        ":TargetsViewWiringTest",
        ":TargetsPageChromeTest",
    ],
)
