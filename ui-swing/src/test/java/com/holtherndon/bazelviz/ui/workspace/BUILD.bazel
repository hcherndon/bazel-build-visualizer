java_junit5_test(
    name = "WorkspaceWindowStateStoreTest",
    test_class = "com.holtherndon.bazelviz.ui.workspace.WorkspaceWindowStateStoreTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "WorkspaceLauncherHistoryMigrationTest",
    test_class = "com.holtherndon.bazelviz.ui.workspace.WorkspaceLauncherHistoryMigrationTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

test_suite(
    name = "tests",
    tests = [
        ":WorkspaceDiscoveryParserTest",
        ":WorkspaceDiscoveryScriptStoreTest",
        ":WorkspaceDiscoveryTest",
        ":WorkspaceLauncherHistoryMigrationTest",
        ":WorkspaceProfileTest",
        ":WorkspaceSelectionPanelTest",
        ":WorkspaceStoreTest",
        ":WorkspaceWindowStateStoreTest",
    ],
)
