load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS")

package(default_visibility = ["//ui-swing:__pkg__"])

java_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//proto:proto",
        "@maven//:com_google_protobuf_protobuf_java",
        "//capture-file/src/main/java/com/holtherndon/bazelviz/capture/file/importer",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/id",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/session",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/portable",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/catalog",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/schema",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bep",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/format",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/session",
    ],
    visibility = ["//visibility:private"],
)

java_junit5_test(
    name = "CatalogAccessTest",
    test_class = "com.holtherndon.bazelviz.ui.session.CatalogAccessTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

