        "//core-model/src/main/java/com/holtherndon/bazelviz/core/journal",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/session",
        "//proto",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/files",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/events",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/graph",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/metrics",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bep",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/events",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/files",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/format",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/inspect",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/nav",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/session",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/table",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/theme",
        "@maven//:com_fifesoft_rsyntaxtextarea",
    ],
    visibility = ["//visibility:private"],
)

