load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS")

package(default_visibility = ["//ui-swing:__pkg__"])

java_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["*.java"]),
    deps = JUNIT_DEPS + [
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/enrich",
        "//core-model/src/main/java/com/holtherndon/bazelviz/core/journal",
        "//proto",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/enrich",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/entities",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/events",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/graph",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/metrics",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage:storage",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/errors",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/inspect",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/session",
    ],
    visibility = ["//visibility:private"],
)

java_junit5_test(
    name = "ErrorConsolePanelTest",
    test_class = "com.holtherndon.bazelviz.ui.errors.ErrorConsolePanelTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "ErrorInspectionTest",
    test_class = "com.holtherndon.bazelviz.ui.errors.ErrorInspectionTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "ErrorsViewSortTest",
    test_class = "com.holtherndon.bazelviz.ui.errors.ErrorsViewSortTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

java_junit5_test(
    name = "ErrorsViewTest",
    test_class = "com.holtherndon.bazelviz.ui.errors.ErrorsViewTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS + [":tests_lib"],
)

test_suite(
    name = "tests",
    tests = [
        ":ErrorConsolePanelTest",
        ":ErrorInspectionTest",
        ":ErrorsViewSortTest",
        ":ErrorsViewTest",
    ],
)
