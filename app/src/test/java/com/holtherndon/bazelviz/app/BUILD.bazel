load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS")

java_library(
    name = "tests_lib",
    srcs = [
        "ApplicationWindowRegistryTest.java",
        "AppInfoTest.java",
        "BoundedMemoryTest.java",
        "LimitsDocTest.java",
        "MainWorkspaceLoadingTest.java",
        "ThirdPartyNoticesTest.java",
        "WorkspaceWindowPolicyTest.java",
        "WorkspaceWindowSnapshotsTest.java",
    ],
    deps = JUNIT_DEPS + [
        "//app/src/main/java/com/holtherndon/bazelviz/app:app",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/plan:plan",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/capture:capture",
        "//ui-swing/src/main/java/com/holtherndon/bazelviz/ui/workspace:workspace",
    ],
    testonly = True,
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "AppInfoTest",
    data = [
        "//app:packaging/jpackage.sh",
        "//app:src/main/packaging/Info.plist",
    ],
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = [
        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.app.AppInfoTest",
    visibility = ["//visibility:public"],
)

