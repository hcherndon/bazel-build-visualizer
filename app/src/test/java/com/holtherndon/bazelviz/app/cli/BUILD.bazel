java_junit5_test(
    name = "RealBazelCliRunTest",
    srcs = ["RealBazelCliRunTest.java"],
    deps = JUNIT_DEPS + [
        "//app/src/main/java/com/holtherndon/bazelviz/app/cli:cli",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session/json:json",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bazel:bazel",
        ":tests_lib",
    ],
    env_inherit = REAL_BAZEL_ENV,
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS,
    size = "large",
    tags = REAL_BAZEL_TAGS,
    test_class = "com.holtherndon.bazelviz.app.cli.RealBazelCliRunTest",
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "CliLoggingProcessTest",
    srcs = ["CliLoggingProcessTest.java"],
    data = ["//app:app_deploy.jar"],
    deps = JUNIT_DEPS + [
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session/json:json",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bep:bep",
    ],
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = JUNIT_RUNTIME_DEPS,
    size = "medium",
    test_class = "com.holtherndon.bazelviz.app.cli.CliLoggingProcessTest",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        ":CliCancellationTest",
        ":CliDamagedSourceTest",
        ":CliHeadlessTest",
        ":CliImportTest",
        ":CliInspectTest",
        ":CliLoggingProcessTest",
        ":CliRunTest",
        ":CliUsageTest",
    ],
    visibility = ["//visibility:public"],
)
