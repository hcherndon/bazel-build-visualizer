load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools:java_test_settings.bzl", "HEADLESS_TEST_JVM_FLAGS", "JUNIT_DEPS", "JUNIT_RUNTIME_DEPS", "REAL_BAZEL_ENV", "REAL_BAZEL_TAGS")

java_library(
    name = "tests_lib",
    srcs = [
        "CliCancellationTest.java",
        "CliDamagedSourceTest.java",
        "CliHarness.java",
        "CliHeadlessTest.java",
        "CliImportTest.java",
        "CliInspectTest.java",
        "CliRunTest.java",
        "CliUsageTest.java",
    ],
    deps = JUNIT_DEPS + [
        "//app/src/main/java/com/holtherndon/bazelviz/app/cli:cli",
        "//capture-bes/src/main/java/com/holtherndon/bazelviz/capture/live:live",
        "//capture-file/src/main/java/com/holtherndon/bazelviz/capture/file/importer:importer",
        "//session-format/src/main/java/com/holtherndon/bazelviz/format/session/json:json",
        "//runner/src/main/java/com/holtherndon/bazelviz/runner/proc:proc",
        "//storage-sqlite/src/main/java/com/holtherndon/bazelviz/storage/events:events",
        "//test-support/src/main/java/com/holtherndon/bazelviz/testsupport/bep:bep",
    ],
    testonly = True,
    visibility = ["//visibility:public"],
)

java_junit5_test(
    name = "CliCancellationTest",
    jvm_flags = HEADLESS_TEST_JVM_FLAGS,
    runtime_deps = [
        ":tests_lib",
    ] + JUNIT_RUNTIME_DEPS,
    test_class = "com.holtherndon.bazelviz.app.cli.CliCancellationTest",
    visibility = ["//visibility:public"],
)

