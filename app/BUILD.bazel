"""Application entry points and package-local compatibility facade."""

load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:java_test_settings.bzl", "NATIVE_ACCESS_FLAG")

exports_files([
    "packaging/jpackage.sh",
    "src/main/packaging/Info.plist",
    "src/main/packaging/bviz.properties",
])

java_library(
    name = "app-lib",
    exports = [
        "//app/src/main/java/com/holtherndon/bazelviz/app/cli:cli",
        "//app/src/main/java/com/holtherndon/bazelviz/app/dirs:dirs",
        "//app/src/main/java/com/holtherndon/bazelviz/app:app",
    ],
    visibility = ["//visibility:public"],
)

java_binary(
    name = "app",
    jvm_flags = [NATIVE_ACCESS_FLAG] + select({
        "@platforms//os:macos": [
            "--add-exports=java.desktop/com.apple.eawt.event=ALL-UNNAMED",
            "'-Xdock:name=Bazel Build Visualizer'",
            "'-Dapple.awt.application.name=Bazel Build Visualizer'",
            "-Dapple.laf.useScreenMenuBar=true",
            "-Dapple.awt.application.appearance=system",
        ],
        "//conditions:default": [],
    }),
    main_class = "com.holtherndon.bazelviz.app.Main",
    resources = ["//app/src/main/resources:resources"],
    runtime_deps = [
        ":app-lib",
        "@maven//:ch_qos_logback_logback_classic",
    ],
    visibility = ["//app:__subpackages__"],
)

genquery(
    name = "app_runtime_maven_deps",
    expression = 'kind("jvm_import|java_import", deps(//app:app))',
    opts = ["--output=build"],
    scope = [":app"],
    visibility = ["//app:__subpackages__"],
)

# Preserve the original launcher and deploy-jar labels while the clearer
# `//app:app` spelling remains the documented entry point.
alias(
    name = "bbv",
    actual = ":app",
)

alias(
    name = "bbv_deploy.jar",
    actual = ":app_deploy.jar",
)

test_suite(
    name = "tests",
    tests = [
        ":release_metadata_test",
        "//app/src/test/java/com/holtherndon/bazelviz/app/cli:tests",
        "//app/src/test/java/com/holtherndon/bazelviz/app/dirs:tests",
        "//app/src/test/java/com/holtherndon/bazelviz/app/logging:tests",
        "//app/src/test/java/com/holtherndon/bazelviz/app:tests",
    ],
)

sh_test(
    name = "release_metadata_test",
    size = "small",
    srcs = ["packaging/release_metadata_test.sh"],
    data = [
        "packaging/jpackage.sh",
        "src/main/packaging/Info.plist",
    ],
)

alias(
    name = "RealBazelCliRunTest",
    actual = "//app/src/test/java/com/holtherndon/bazelviz/app/cli:RealBazelCliRunTest",
)

sh_binary(
    name = "jpackage",
    srcs = ["packaging/jpackage.sh"],
    data = [
        "src/main/packaging/Info.plist",
        "src/main/packaging/bviz.properties",
        ":app_deploy.jar",
    ],
)

sh_binary(
    name = "notarize",
    srcs = ["packaging/notarize.sh"],
)
