# Entry point and composition root.

load("//tools:bbv.bzl", "bbv_java_binary", "bbv_java_library", "bbv_java_test_suite", "bbv_real_bazel_test")

# The macOS file association for .bviz (plan 24, Phase 9): consumed by the
# jpackage target below and read cross-module by Phase9ExitCriteriaTest.
exports_files(["src/main/packaging/bviz.properties"])

bbv_java_library(
    name = "app",
    deps = [
        "//core-model",
        "//ui-swing",
        # The headless subcommands in `app/cli` drive the Phase 1 import
        # pipeline directly. capture-file already exposes session-format and
        # storage-sqlite as exports, but both are named here as well because
        # this module's own source imports SessionManager and SessionDatabase
        # — a dependency a file compiles against belongs in its own build
        # file, not inherited by accident from a sibling's api surface.
        "//capture-file",
        # `bbv run` drives the Phase 2 capture path: the coordinator, the
        # embedded BES server and the launcher. capture-bes exposes
        # bazel-runner as exports, but the runner is named here too because
        # this module's own source imports CapturePreset, PlanConflict and
        # CancellationMode.
        "//capture-bes",
        "//bazel-runner",
        "//session-format",
        "//storage-sqlite",
        # For BepPayloadType: `inspect` prints "targetCompleted (7)" rather
        # than a bare payload-case number.
        "//bep-codec",
    ],
    runtime_deps = ["@maven//:ch_qos_logback_logback_classic"],
)

# The application. `bazel run //app:bbv -- <args>`; system properties go as
# `--jvm_flag=-Dbbv.smoke=true` before the program args (the java_binary stub
# accepts leading --jvm_flag= arguments). //app:bbv_deploy.jar is the
# single-file distribution and what the jpackage target packages.
bbv_java_binary(
    name = "bbv",
    # FlatLaf's NativeLibrary calls System::load for the macOS window
    # decorations, so this launcher carries the native-access grant on every
    # platform, not just macOS (bbv_java_binary adds it). The dock/menu-bar
    # flags select on the target platform — an improvement over Gradle,
    # which keyed on the build host's OS.
    jvm_flags = select({
        "@platforms//os:macos": [
            "'-Xdock:name=Bazel Build Visualizer'",
            "'-Dapple.awt.application.name=Bazel Build Visualizer'",
            "-Dapple.laf.useScreenMenuBar=true",
            "-Dapple.awt.application.appearance=system",
        ],
        "//conditions:default": [],
    }),
    main_class = "com.holtherndon.bazelviz.app.Main",
    runtime_deps = [":app"],
)

# Every test in this module runs headless, matching the environment CI gives
# the `bbv import` / `bbv inspect` commands.
bbv_java_test_suite(
    name = "tests",
    # LimitsDocTest parses docs/limits.md against the constants it names.
    data = ["//docs:limits.md"],
    exclude = ["src/test/java/com/holtherndon/bazelviz/app/cli/RealBazelCliRunTest.java"],
    headless = True,
    deps = [
        ":app",
        "//bazel-runner",
        "//bep-codec",
        "//capture-bes",
        "//capture-file",
        "//core-model",
        "//session-format",
        "//storage-sqlite",
        # The CLI tests import real synthetic BEP fixtures and the
        # deliberate-damage helpers, so the truncated-source exit code is
        # proved against a genuinely truncated protobuf stream rather than a
        # hand-built one.
        "//test-support",
        "//ui-swing",
    ],
    runtime_deps = ["@maven//:ch_qos_logback_logback_classic"],
)

bbv_real_bazel_test(
    name = "RealBazelCliRunTest",
    srcs = ["src/test/java/com/holtherndon/bazelviz/app/cli/RealBazelCliRunTest.java"],
    jvm_flags = ["-Djava.awt.headless=true"],
    test_class = "com.holtherndon.bazelviz.app.cli.RealBazelCliRunTest",
    runtime_deps = ["@maven//:ch_qos_logback_logback_classic"],
    deps = [
        ":app",
        ":tests-lib",
        "//core-model",
        "//session-format",
        "//test-support",
    ],
)
